{
	"name": "obsidian-ketcher",
	"version": "0.2.1",
	"description": "Draw chemical structures and reactions using Ketcher.",
	"main": "main.js",
	"type": "module",
	"engines": {
		"node": ">=24.14.1"
	},
	"scripts": {
		"dev": "node esbuild.config.mjs",
		"build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
		"lint": "eslint .",
		"verify-release": "node scripts/verify-release.mjs",
		"version": "node version-bump.mjs && git add manifest.json versions.json"
	},
	"keywords": [
		"chemistry",
		"molecule",
		"chemical structures",
		"chemical reactions",
		"ketcher"
	],
	"author": "Yulei Chen",
	"repository": "https://github.com/yulei-chen/obsidian-ketcher",
	"license": "Apache-2.0",
	"devDependencies": {
		"@eslint/js": "^9.39.4",
		"@types/node": "^22.15.17",
		"@types/react": "^19.1.8",
		"@types/react-dom": "^19.1.6",
		"esbuild": "0.25.5",
		"eslint": "^9.39.4",
		"eslint-plugin-obsidianmd": "^0.4.0",
		"globals": "^17.6.0",
		"jiti": "^2.6.1",
		"obsidian": "latest",
		"typescript": "^5.8.3",
		"typescript-eslint": "^8.59.1"
	},
	"dependencies": {
		"ketcher-core": "3.17.2",
		"ketcher-react": "3.17.2",
		"ketcher-standalone": "3.17.2",
		"react": "19.2.8",
		"react-dom": "19.2.8"
	}
}
